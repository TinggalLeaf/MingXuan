# ===== 明玄 MingXuan · 功能配置 =====
# 复制本文件为 .env 后按需修改。Vite 仅暴露 VITE_ 前缀变量，在构建时内联。

# ---- 站点信息 ----
VITE_SITE_NAME=明玄
VITE_SITE_SLOGAN=以古今之智，观人生起伏

# ---- 功能模块开关（true/false），关闭后对应入口隐藏 ----
VITE_FEATURE_BAZI=true
VITE_FEATURE_ZIWEI=true
VITE_FEATURE_ASTROLABE=true
VITE_FEATURE_QIZHENG=true
VITE_FEATURE_FENGSHUI=true
VITE_FEATURE_KLINE=true
VITE_FEATURE_HEPAN=true
VITE_FEATURE_LIUYAO=true
VITE_FEATURE_MEIHUA=true
VITE_FEATURE_QIMEN=true
VITE_FEATURE_LIUREN=true
VITE_FEATURE_TAIYI=true
VITE_FEATURE_HUANGJI=true
VITE_FEATURE_WUYUN=true
VITE_FEATURE_TAROT=true
VITE_FEATURE_LINGQIAN=true
VITE_FEATURE_ZERI=true

# ---- 人生 K 线 ----
# up/down 配色：cn = 红涨绿跌（A股习惯），us = 绿涨红跌
VITE_KLINE_COLOR_MODE=cn
# K 线默认起算跨度（年）
VITE_KLINE_YEARS=100

# ---- AI 解读（可选，OpenAI 兼容接口；留空则隐藏 AI 功能） ----
VITE_AI_BASE_URL=http://localhost:8000
VITE_AI_API_KEY=
VITE_AI_MODEL=qwen-8b

# ---- 排盘默认项 ----
# 默认是否启用真太阳时
VITE_DEFAULT_TRUE_SOLAR_TIME=false
# 紫微安星法：default / zhongzhou
VITE_ZIWEI_ALGORITHM=default
